# =============================================================================
# Example secrets file for running the pipeline locally with `act`
# (https://github.com/nektos/act).
#
# HOW TO USE:
#   1. Copy this file:   cp .secrets.example .secrets
#   2. Fill in real values in `.secrets` (never commit that file - it's
#      already covered by .gitignore).
#   3. Run:  act -j build-and-scan --secret-file .secrets
# =============================================================================

# Free personal token from https://app.snyk.io -> Account settings ->
# General -> API Token. (Not the paid "Service accounts" / REST API -
# the CLI/CI personal token is free-tier.)
SNYK_TOKEN=your-snyk-token-here

# Token generated from your LOCAL SonarQube instance (see
# docker-compose.yml): http://localhost:9000 -> My Account -> Security ->
# Generate Tokens.
SONAR_TOKEN=your-local-sonarqube-token-here

# URL of your local SonarQube server, as reachable FROM INSIDE the act
# runner container (not "localhost", since that resolves to the
# container itself, not your host machine):
#   - Docker Desktop (Mac/Windows): host.docker.internal
#   - Linux: use your host's docker bridge IP, e.g. 172.17.0.1,
#     or run act with --network host and use localhost directly.
SONAR_HOST_URL=http://host.docker.internal:9000
